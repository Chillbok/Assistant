# 시크릿 설정 파일
#
# 형식 규칙
#   - 한 줄에 KEY=value 하나만 쓴다. export, 공백 구분자, 콜론 구분자는 쓰지 않는다.
#   - 값에 $, #, 공백이 들어가면 작은따옴표로 감싼다. 예: KEY='a b#c$d'
#   - 인라인 주석을 쓰지 않는다. 주석은 반드시 줄 맨 앞에 #으로만.
#   - 이 파일은 절대 git에 커밋하지 않는다.
#
# 위치: ~/.config/assistant/env  (권한 600)
# 변경 후에는 docker compose restart가 아니라 docker compose up -d 로 재생성해야 반영된다.

# --- 텔레그램 (필수) ---
# @BotFather → /newbot 또는 /mybots → API Token
TELEGRAM_BOT_TOKEN=

# 봇이 응답할 사용자 id. 쉼표로 구분.
# 비워두면 아무에게도 응답하지 않고, 수신한 메시지의 id를 로그에 남긴다.
TELEGRAM_ALLOWED_USER_IDS=
